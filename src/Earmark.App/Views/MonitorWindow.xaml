<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Earmark.App.Views.MonitorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <!-- Solid mode (and the unsupported-material fallback) has no system backdrop, so this
             opaque fill sits behind the content; the backdrop otherwise shows through. -->
        <Border x:Name="SolidBackdrop"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Visibility="Collapsed" />

        <ListView x:Name="DeviceList"
                  Padding="{StaticResource SectionPadding}"
                  SelectionMode="None"
                  IsItemClickEnabled="False" />
    </Grid>
</Window>
